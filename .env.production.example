# Copy to .env on the server (cp .env.production.example .env) and fill in. Never commit .env.

# The server's public IP with dashes plus .sslip.io, e.g. 140-238-12-34.sslip.io (free, no domain needed),
# or your own domain if you have one.
SITE_ADDRESS=

# Generate with: openssl rand -hex 24   (letters and digits only, so it is safe inside the database URL)
POSTGRES_PASSWORD=

# Generate with: openssl rand -hex 32
SECRET_KEY=
